# Server-side only. Never use VITE_ or NEXT_PUBLIC_ for these values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Alternative private Edge bridge when a service-role key is unavailable.
SUPABASE_ANON_KEY=
TP_DB_BRIDGE_URL=
TP_DB_BRIDGE_TOKEN=
TP_MASTER_SECRET=
CRON_SECRET=
# Optional allowlist for browser origins. Native desktop reads use no cookie auth.
TP_ALLOWED_ORIGINS=
# Up to 96 claimed checks per invocation; a time budget defers unfinished jobs.
TP_WORKER_BATCH_SIZE=96
TP_WORKER_CONCURRENCY=8

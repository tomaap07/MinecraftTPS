# Server-side only. Never use VITE_ or NEXT_PUBLIC_ for these values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Alternative private Edge bridge when a service-role key is unavailable.
SUPABASE_ANON_KEY=
TP_DB_BRIDGE_URL=
TP_DB_BRIDGE_TOKEN=
TP_MASTER_SECRET=
CRON_SECRET=
# Optional allowlist for browser origins. Native desktop reads use no cookie auth.
TP_ALLOWED_ORIGINS=
# Up to 96 claimed checks per invocation; a time budget defers unfinished jobs.
TP_WORKER_BATCH_SIZE=96
TP_WORKER_CONCURRENCY=8

# TP Cloud staging is a separate opt-in service, disabled by default.
# Never send these keys or Microsoft tokens to the mod or launcher webview.
TP_CLOUD_ENABLED=false
TP_CLOUD_SUPABASE_URL=
TP_CLOUD_PUBLISHABLE_KEY=
TP_CLOUD_SERVICE_ROLE_KEY=
TP_CLOUD_ALLOWED_ORIGINS=

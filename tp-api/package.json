{
  "name": "tp-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "seed": "node --env-file-if-exists=.env.local dist/scripts/seed-servers.js",
    "keys:create": "node --env-file-if-exists=.env.local dist/scripts/create-api-key.js"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@types/node": "22.15.30",
    "@types/pngjs": "6.0.5",
    "typescript": "6.0.3"
  },
  "license": "GPL-3.0-only",
  "dependencies": {
    "pngjs": "7.0.0"
  }
}

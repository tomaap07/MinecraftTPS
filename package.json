{
  "name": "launchertps",
  "version": "0.1.1",
  "description": "TP LAUNCHER · Minecraft Java, contenido y creación",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:companion": "node scripts/build-companion.mjs",
    "build:desktop": "npm run build:bridge && npm run build:companion && npm run build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:ui": "node scripts/check-ui-contracts.mjs",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "build:bridge": "node scripts/build-bridge.mjs",
    "test:hud": "node scripts/test-hud-metrics.mjs && node scripts/test-bridge.mjs"
  },
  "license": "GPL-3.0-only",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "skinview3d": "^3.4.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.20.5",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
